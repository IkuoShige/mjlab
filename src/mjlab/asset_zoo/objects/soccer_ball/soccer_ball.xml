<mujoco model="soccer_ball">
  <compiler angle="radian"/>

  <default>
    <geom condim="6"/>
  </default>

  <worldbody>
    <body name="ball_body">
      <freejoint name="ball_joint"/>
      <inertial pos="0 0 0" mass="0.43" diaginertia="0.0021 0.0021 0.0021"/>
      <!-- condim="6" enables full friction: sliding + torsional + 2-axis
           rolling. friction = (sliding, torsional, rolling). Bumped
           rolling 0.0001 → 0.05 and torsional 0.005 → 0.01 to match real
           soccer ball on indoor surfaces (rolls to a halt in 1-3 seconds
           rather than rolling forever). solref/solimp unchanged. -->
      <geom name="ball_collision"
            type="sphere" size="0.11"
            friction="1.0 0.01 0.05"
            solref="-10000 -100"
            solimp="0.9 0.95 0.001 0.5 2"
            priority="0"
            group="1"/>
      <geom name="ball_visual"
            type="sphere" size="0.11"
            contype="0" conaffinity="0"
            group="0"
            rgba="1.0 0.5 0.0 1.0"/>
    </body>
  </worldbody>
</mujoco>
